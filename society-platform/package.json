{
  "name": "society-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite web --host 127.0.0.1",
    "start:local": "node scripts/run-local.mjs",
    "test:launcher": "node --test tests/launcher.test.mjs",
    "test:launcher:smoke": "node --test tests/launcher-smoke.test.mjs",
    "dev:emulator": "vite web --host 127.0.0.1 --mode emulator",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-society-platform",
    "seed:local": "node backend/seed.mjs",
    "build": "tsc --noEmit && vite build web",
    "preview": "vite preview web --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --config firebase.test.json --only firestore --project demo-society-platform-tests \"node --test backend/firestore/tests/*.test.mjs\"",
    "test:backend": "firebase emulators:exec --config firebase.test.json --only auth,firestore --project demo-society-platform-tests \"node --test backend/firestore/tests/*.test.mjs backend/auth/tests/*.test.mjs\""
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  },
  "dependencies": {
    "@fontsource/poppins": "5.3.0",
    "firebase": "13.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "firebase-tools": "15.34.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
